	<text>
		<body>
			<div>
				<div type="page"><pb facs="#facs_1" n="1"/>
				<p facs="#facs_1_tr_1">
					<lb facs="#facs_1_l" n="N001"/>Lieber <choice><expan>obrist</expan><abbr>ob.</abbr></choice> <add>kämmerer</add>. Hiemitt <choice><expan/><abbr>das</abbr></choice> schreiben ad archiducem
					<lb facs="#facs_1_l_1" n="N002"/><choice><expan/><abbr>per</abbr></choice> <unclear>iterum</unclear>. Deus assistat bene conanti et faciat,
					<lb facs="#facs_1_tr_1_tl_5" n="N003"/>ut negotia prospere succedant. Hab weitter
					<lb facs="#facs_1_tr_1_tl_6" n="N004"/>nix beyzusezen, schikhe also alle schrifften, wider
					<lb facs="#facs_1_tr_1_tl_8" n="N005"/>zurukh
					<lb facs="#facs_1_l_2" n="N006"/><choice><expan>Leopoldt</expan><abbr>L.</abbr></choice>
					<lb facs="#facs_1_tr_1_tl_7" n="N007"/><choice><expan/><abbr>Den</abbr></choice> 31. Merz 1665
				</p>
				</div><div type="page"><pb facs="#facs_2" n="2"/>
			</div></div>
		</body>
	</text>
