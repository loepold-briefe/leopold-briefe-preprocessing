	<text>
		<body>
			<div>
				<div type="page"><pb facs="#facs_1" n="1"/>
				<p facs="#facs_1_r">
					<lb facs="#facs_1_r_tl_1" n="N001"/>Lieber graff von Lamberg. Ich hab eür
					<lb facs="#facs_1_r_tl_2" n="N002"/>schreiben von 26. passato zu recht empfangen vnd
					<lb facs="#facs_1_r_tl_3" n="N003"/>darauß beeder <choice><expan/><abbr>Majestäten</abbr></choice> vnd <choice><expan/><abbr>Durchleechtikheitten</abbr></choice> guetten
					<lb facs="#facs_1_r_tl_5" n="N004"/>gesondt gar gern verstanden. <sic rend="error" n="Die">Di</sic> sachen lassen
					<lb facs="#facs_1_l_2" n="N005"/>sich in bekhandten negotio nuhn zimblich an, <del rend="strikethrough">vnd </del>
					<lb facs="#facs_1_r_tl_7" n="N006"/>khan aber <choice><expan/><abbr>propter</abbr></choice> certas causas noch nichts specifice
					<lb facs="#facs_1_r_tl_8" n="N007"/>schreiben. <corr>W</corr>ollett eingeschossnes Ihr <choice><expan>Majestät</expan><abbr>M.</abbr></choice> der <sic rend="error" n="konigin">konig</sic>
					<lb facs="#facs_1_r_tl_9" n="N008"/>vbergeben. Vnd ich verbleibe eüch allezeitt mitt
					<lb facs="#facs_1_l_1" n="N009"/>genaden vnd hulden wolgewogen
					<lb facs="#facs_1_l_4" n="N010"/>Leopoldt 
					<lb facs="#facs_1_l" n="N011"/>Praag, <choice><expan/><abbr>den</abbr></choice> 12. <choice><expan>Septembris</expan><abbr>7bris</abbr></choice>
					<lb facs="#facs_1_r_tl_11" n="N012"/>1657
				</p>
				</div><div type="page"><pb facs="#facs_2" n="2"/>
				</div><div type="page"><pb facs="#facs_3" n="3"/>
				</div><div type="page"><pb facs="#facs_4" n="4"/>
			</div></div>
