	<text>
		<body>
			<div>
				<div type="page"><pb facs="#facs_1" n="1"/>
				<p facs="#facs_1_r">
					<lb facs="#facs_1_r_tl_1" n="N001"/>Lieber Lamberg. <corr>Ihr</corr> khönett eüch leicht
					<lb facs="#facs_1_r_tl_2" n="N002"/>einbilden, mitt waß für freiden <del rend="strikethrough">eüch</del> der von
					<lb facs="#facs_1_r_tl_3" n="N003"/>eüch <sic rend="error" n="geschikhte">geschikhe</sic> <choice><expan>Maximilian</expan><abbr>Ma<corr>x</corr>.</abbr></choice> von Seeaw vnß alle alhie
					<lb facs="#facs_1_r_tl_4" n="N004"/>erfüllett, in deme er vnß die schon so lang
					<lb facs="#facs_1_r_tl_5" n="N005"/>vnd sehr verlangte zeittung dermal eins gebracht.
					<lb facs="#facs_1_r_tl_6" n="N006"/>Die zeittung ist gestern abendts, in deme ich
					<lb facs="#facs_1_r_tl_7" n="N007"/>ein reprasentation vor der khrippel <del rend="strikethrough">geha<corr>lt</corr></del> gehadlen
					<lb facs="#facs_1_r_tl_8" n="N008"/>vnd der engel just die wort gesungen Annuntio
					<lb facs="#facs_1_r_tl_9" n="N009"/>vobis gaudium magnum, quia natus est vobis
					<lb facs="#facs_1_r_tl_10" n="N010"/>parvulus,
					<lb facs="#facs_1_l" n="N011"/>ankhommen, also hatt es sich alles gar wol geschikt.
					<lb facs="#facs_1_r_tl_13" n="N012"/>Der Portia ist alßbaldt in die cappel geloffen
					<lb facs="#facs_1_r_tl_14" n="N013"/>vnd vber lautt die b<corr>on</corr>a nova deme marquese <sic rend="error" n="de la">dla</sic> Fuente,
					<lb facs="#facs_1_r_tl_15" n="N014"/>so auch gegnwertig war, gesagt vnd gegeben. Der Fuente
					<lb facs="#facs_1_r_tl_16" n="N015"/>ist dem Portia vmb den halß gefallen vnd alßbadt
					<lb facs="#facs_1_r_tl_17" n="N016"/>zum Peñeranda gefaren, welchen aber der Seaw
					<lb facs="#facs_1_r_tl_18" n="N017"/><choice><expan/><abbr>prae</abbr></choice>ocupirdt vnd furkho<choice><expan/><abbr>mm</abbr></choice>en, darauff die beede potschaffter
					<lb facs="#facs_1_r_tl_19" n="N018"/>alßbaldt herein khommen vnd neben vbereichung der
					<lb facs="#facs_1_r_tl_20" n="N019"/><choice><expan>khöniglichen</expan><abbr>khön.</abbr></choice> schreiben die gbürende complimenta abgelegt.
					<lb facs="#facs_1_r_tl_21" n="N020"/><corr>Ich</corr> habe auch noch gestern alßbadt ein eignen
					<lb facs="#facs_1_r_tl_23" n="N021"/>cammerdiener zu Ihr <choice><expan>Mayestät</expan><abbr>May.</abbr></choice> der khayserin abgeordnet,
					<lb facs="#facs_1_r_tl_24" n="N022"/>ihr dise zeittung zu vberbringen. Benedictus sit deus.
				</p>
				</div><div type="page"><pb facs="#facs_2" n="2"/>
				<p facs="#facs_2_tr_1">
					<lb facs="#facs_2_tr_1_tl_1" n="N001"/>Morgen werden ich alhie daß Te deum vnd gala
					<lb facs="#facs_2_tr_1_tl_2" n="N002"/>in schwarz seiden haldten. Ich khan eüch nitt
					<lb facs="#facs_2_l_1" n="N003"/><del rend="strikethrough">guetter</del>
					<lb facs="#facs_2_tr_1_tl_3" n="N004"/>beschreiben,
					<lb facs="#facs_2_l" n="N005"/>waß die anwesende hispani für eine jubell
					<lb facs="#facs_2_tr_1_tl_5" n="N006"/>gehabt, dann sie bey der nacht mitt fakhlen
					<lb facs="#facs_2_tr_1_tl_6" n="N007"/>vmgeloffen vnd allezeitt Viva el rey e Viva la
					<lb facs="#facs_2_tr_1_tl_7" n="N008"/>señora reyna geschriehen. In summa es ist ein solcher
					<lb facs="#facs_2_tr_1_tl_8" n="N009"/>rumor gewest, daß ich es nicht genueg ausprechen kha<choice><expan/><abbr>nn</abbr></choice>.
					<lb facs="#facs_2_tr_1_tl_9" n="N010"/><corr>B</corr>efelhe eüch also hiemitt, daß ihr alßbaldt bey <choice><expan/><abbr>den</abbr></choice> beeden
					<lb facs="#facs_2_tr_1_tl_10" n="N011"/><choice><expan/><abbr>Majestäten</abbr></choice> audienz begehrn <corr>v</corr>nd von meinetwegen neben
					<lb facs="#facs_2_tr_1_tl_11" n="N012"/>einreichung der beyko<choice><expan/><abbr>mm</abbr></choice>enden schreiben die congratulation
					<lb facs="#facs_2_l_3" n="N013"/>consuetis curialibus <del rend="strikethrough">ablegen</del>
					<lb facs="#facs_2_tr_1_tl_12" n="N014"/>vnd versicherung
					<lb facs="#facs_2_l_2" n="N015"/>aller ganz sonhlicher
					<lb facs="#facs_2_tr_1_tl_14" n="N016"/>affection vnd lieb verichten sollett. Sonst hab
					<lb facs="#facs_2_tr_1_tl_15" n="N017"/>ich anbey <sic rend="error" n="vergangner">vergagner</sic> ordinari 2 schreiben von lezten <choice><expan>Octobris</expan><abbr>8bris</abbr></choice>
					<lb facs="#facs_2_tr_1_tl_16" n="N018"/>empfangen <gap/>  vnd <sic rend="error" n="darauß">daßauß</sic> ersehen, wie an statt des
					<lb facs="#facs_2_tr_1_tl_17" n="N019"/>Fuensaldaña der Ognate auf Meylandt khommen solle.
					<lb facs="#facs_2_tr_1_tl_18" n="N020"/>Waß die heraußige sachen betrifft, lasset es sich alles
					<lb facs="#facs_2_tr_1_tl_19" n="N021"/>also wol an, daß ich hoffen, auf daß baldtiste
					<lb facs="#facs_2_tr_1_tl_20" n="N022"/>eüch ein gewißheitt von meiner abreiß zuzuschreiben.
					<lb facs="#facs_2_tr_1_tl_21" n="N023"/>Plura Portia. Verbleibe also allezeitt euch mitt
					<lb facs="#facs_2_tr_1_tl_22" n="N024"/><choice><expan>königlichen</expan><abbr>kön.</abbr></choice> hulden vnd genadten wol gewogen
					<lb facs="#facs_2_tr_1_tl_25" n="N025"/>Leopoldt
					<lb facs="#facs_2_tr_1_tl_23" n="N026"/>Prag, den 26 <choice><expan>Decembris</expan><abbr>xb.</abbr></choice>
					<lb facs="#facs_2_tr_1_tl_24" n="N027"/>1657
				</p>
				</div><div type="page"><pb facs="#facs_3" n="3"/>
				</div><div type="page"><pb facs="#facs_4" n="4"/>
