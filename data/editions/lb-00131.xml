	<text>
		<body>
			<div>
				<div type="page"><pb facs="#facs_1" n="1"/>
				<p facs="#facs_1_tr_1">
					<lb facs="#facs_1_tr_1_tl_1" n="N001"/>Lieber Lamberg. Auß euren von 27. Februarij sehe
					<lb facs="#facs_1_tr_1_tl_2" n="N002"/>ich mitt <sic rend="error" n="mehrerm">mehrrhen</sic> beeder <choice><expan/><abbr>Majestäten</abbr></choice> vnd infantinen <sic rend="error" n="guette">guettern</sic>
					<lb facs="#facs_1_tr_1_tl_3" n="N003"/><choice><expan>gesondtheit</expan><abbr>gesondt</abbr></choice>. Wir befinden vnß gottlob gar wol auff. 
					<lb facs="#facs_1_tr_1_tl_4" n="N004"/><seg type="cypher" n="Weilen">6 fa w 3 4 5 l 6 3 n Ko</seg> <seg type="code" n="Trier,">AL</seg> <seg type="code" n="Bayern,">AM</seg> <seg type="code" n="Sachsen,">AN</seg> <seg type="code" n="Brandenburg">AO</seg> <seg type="cypher" n="fest auf vnserer">f 3 s t 1 9 f 6 9 n 6 <corr>s</corr> 3 r gli 3 r 6 4 2</seg>
					<lb facs="#facs_1_tr_1_tl_5" n="N005"/><seg type="cypher" n="seiten halten, so thuet">s 3 6 5 t 4 3 <hi rend="superscript">n</hi> h 1 l t 3 n lom s 7 t h 9 3 6 t 4</seg> <seg type="code" n="Mainz">AI</seg> <seg type="cypher" n="sich auch accomodi">s 5 c 6 h 1 9 rum c 4 h <w type="start">1 c 6 c 7 m 4 7 d 5 2</w></seg>
					<lb facs="#facs_1_tr_1_tl_6" n="N006"/><seg type="cypher" n="ren"><w type="end">r 8 3 n</w></seg> vnd haben <seg type="code" n="Trier">AL</seg> <seg type="code" n="[und] Sachsen">AN</seg> <seg type="cypher" n="gestert es dahin gebracht">g 3 s t 8 3 r fi t 3 s d 1 h 5 n fam g 3 b r 1 6 c 4 h 2 t</seg>,
					<lb facs="#facs_1_tr_1_tl_7" n="N007"/>daß wilß gott <seg type="cypher" n="kinftigen montag die">K 5 n 2 f gli t 5 g 2 3 4 n m 7 n t 4 1 8 2 6 g ba d 5 6 3</seg>
					<lb facs="#facs_1_tr_1_tl_8" n="N008"/><seg type="cypher" n="erste zusammenkunft vber dii w">fo 3 r s t 3 z 9 s 1 m 4 m 3 n  gli K 9 n bo f t 9 b 3 r lim d 6 4 5 2 8 5 <w type="start">w te</w></seg>
					<lb facs="#facs_1_tr_1_tl_9" n="N009"/><seg type="cypher" n="al wirt gehalten werden"><w type="end">4 1 l</w> go w 5 r t fa g 3 h fo 1 l t 6 3 4 n w 3 r d 4 2 3 n</seg>. Hoffe, es wirdt
					<lb facs="#facs_1_l" n="N010"/>alles wol abgehen. Hibey schikhe ich euch auch die einzug,
					<lb facs="#facs_1_tr_1_tl_12" n="N011"/><sic rend="error" n="von mir">mon wir</sic> vnd den anderen herren khurfürsten vnd dero gesandten.
					<lb facs="#facs_1_l_3" n="N012"/>Vnd verbleibe alzeitt eur gnedigstes herr
					<lb facs="#facs_1_tr_1_tl_15" n="N013"/>Leopoldt
					<lb facs="#facs_1_l_2" n="N014"/><choice><expan>Frankfurt</expan><abbr>Fft.</abbr></choice>, den 5. April
					<lb facs="#facs_1_tr_1_tl_14" n="N015"/>1658
					<lb facs="#facs_1_l_1" n="N016"/>P. S. 
					<lb facs="#facs_1_tr_1_tl_20" n="N017"/>Der khurfürst auß Saxen ist verwichnen montag alhie
					<lb facs="#facs_1_tr_1_tl_21" n="N018"/>ankhommen, ist voller guetter intentionen. Weilen
					<lb facs="#facs_1_tr_1_tl_24" n="N019"/><seg type="code" n="Trier">AL</seg>, <seg type="cypher">6 4</seg> <seg type="code" n="Bayern">AM</seg>, <seg type="cypher">fo</seg> <seg type="code" n="Sachsen">AN</seg>, <seg type="cypher">2 8</seg> <seg type="code" n="Brandenburg">AO</seg> <seg type="cypher" n="mitt uns halten werden">m 5 t t 9 n s h 1 6 l t 3 n fom w 3 4 <corr>r</corr> d 3 n</seg>, <seg type="code" n="Mainz">AI</seg>, <seg type="code" n="Köln">AK</seg>,
					<lb facs="#facs_1_tr_1_tl_25" n="N020"/><seg type="code" n="Pfalz">AP</seg> <seg type="cypher" n="allein nitt vil ausrichten">1 l 4 l 3 5 n n 5 t 6 t lim 9 5 l gen 1 9 s r 5 c 4 h t 4 2 6 8 3 n glo 6 8 2 4 Hom</seg>.
				</p>
				</div><div type="page"><pb facs="#facs_2" n="2"/>
				</div><div type="page"><pb facs="#facs_3" n="3"/>
				</div><div type="page"><pb facs="#facs_4" n="4"/>
			</div></div>
