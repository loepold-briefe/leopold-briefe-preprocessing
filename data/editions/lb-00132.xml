	<text>
		<body>
			<div>
				<div type="page"><pb facs="#facs_1" n="1"/>
				<p facs="#facs_1_tr_1">
					<lb facs="#facs_1_tr_1_tl_1" n="N001"/>Lieber Lamberg. Mir sein zwey von euren schreiben von 27.
					<lb facs="#facs_1_tr_1_tl_2" n="N002"/>Martij vnd 3. April zu recht eingelieferdt worden. Auß den leztern
					<lb facs="#facs_1_tr_1_tl_3" n="N003"/>hab vngern verstanden, daß der prinz so vbel auf war, hoffe
					<lb facs="#facs_1_tr_1_tl_4" n="N004"/>zu Gott, es werde sich nunhmer gebesserdt haben. Quod res nostras atting<choice><expan/><abbr>it</abbr></choice>,
					<lb facs="#facs_1_tr_1_tl_5" n="N005"/><seg type="cypher" n="gehet es sehr slafferig zue">g ba 3 h 4 3 t 6 3 s s 3 h r glo s l 1 f 2 f 3 r 5 g 6 z 9 3</seg>. <seg type="code" n="Mainz,">AI</seg> <seg type="cypher">4</seg> <seg type="code" n="Köln,">AK</seg> <seg type="cypher">fa 2</seg> <seg type="code" n="Pfalz">AP</seg> <seg type="cypher" n="seint">s 3 5 nt</seg>
					<lb facs="#facs_1_tr_1_tl_6" n="N006"/><seg type="cypher" n="gar adicti">g 1 r 6 1 d 4 5 c t 5</seg> <seg type="code" n="dem König von Frankreich">AE</seg> vnd geedenkhen <seg type="cypher" n="die wahl nur auf die">d 5 3 6 w 1 h 8 l n 9 r fu 1 9 f d 5 2 3</seg>
					<lb facs="#facs_1_tr_1_tl_7" n="N007"/><seg type="cypher" n="bankh zue verschieben">b 1 n 4 k h z 9 6 3 v 3 r bo s c gli h 5 4 3 b 8 3 n</seg>. <seg type="code" n="Trier">AL</seg>, <seg type="code" n="Bayern">AM</seg>, <seg type="code" n="Sachsen">AN</seg> <seg type="cypher" n="halten sich">h 1 l t 3 n s 5 c 2 h</seg>
					<lb facs="#facs_1_tr_1_tl_8" n="N008"/><seg type="cypher" n="wol">w 7 l fa</seg>, <seg type="code" n="Brandenburg">AO</seg> <seg type="cypher" n="lavirt">l 1 v 5 r 6 t</seg>  vnd mitt bemeldten <seg type="cypher" n="laviren ver">l glo 1 6 v 4 5 r 2 3 n <w type="start">v 3 r</w></seg>
					<lb facs="#facs_1_l" n="N009"/><seg type="cypher" n="dirbt er immerzue die suppen"><w type="end">d 5 r b 2 t</w> 3 r Ko 5 m 4 m 3 r mo z 9 <unclear><corr>r</corr></unclear>ca 3 d 4 <corr>5</corr> 3 s 9 p 6 p 3 n</seg>. In summa
					<lb facs="#facs_1_tr_1_tl_11" n="N010"/><seg type="cypher" n="res nostrae in malo statu versantur"><del rend="strikethrough">d</del> r 3 s n 7 s t r 1 3 mo 5 n m 1 l 7 s t i t 9 bi v 3 r 6 s 1 fo n t 9 6 r.</seg> Hiebey khompt
					<lb facs="#facs_1_tr_1_tl_12" n="N011"/>ein <unclear>pagetl</unclear> an die konigin vnd 1 schreiben an konig. <corr>V</corr>nd ich
					<lb facs="#facs_1_l_3" n="N012"/>verbleib euch im <sic rend="error" n="vbrigen">vbrige</sic> allezeit wol gewogen.<note>Leopolds Unterschrift fehlt.</note>
					<lb facs="#facs_1_l_2" n="N013"/><choice><expan>Frankfurdt</expan><abbr>FFudt</abbr></choice>, den 10. May
					<lb facs="#facs_1_tr_1_tl_15" n="N014"/>1658
				</p>
				</div><div type="page"><pb facs="#facs_2" n="2"/>
				</div><div type="page"><pb facs="#facs_3" n="3"/>
				</div><div type="page"><pb facs="#facs_4" n="4"/>
			</div></div>
