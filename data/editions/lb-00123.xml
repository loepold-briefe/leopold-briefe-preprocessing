	<text>
		<body>
			<div>
				<div type="page"><pb facs="#facs_1" n="1"/>
				<p facs="#facs_1_tr_1">
					<lb facs="#facs_1_l_1" n="N001"/>Duplicatum.
					<lb facs="#facs_1_tr_1_tl_2" n="N002"/>Lieber graff von Lamberg. Auß eüren schreiben
					<lb facs="#facs_1_tr_1_tl_3" n="N003"/>von 17. <choice><expan>Octobris</expan><abbr>8bris</abbr></choice> hab ich eüre pretension den <choice><expan>obrist</expan><abbr>ob.</abbr></choice>
					<lb facs="#facs_1_tr_1_tl_4" n="N004"/>ca<choice><expan/><abbr>mm</abbr></choice>erer dienst <choice><expan>betreffend</expan><abbr>bet.</abbr></choice> gar wol vernummen. Nun bin
					<lb facs="#facs_1_tr_1_tl_5" n="N005"/>ich noch nitt resolvirdt, den Portia der würkhlichen
					<lb facs="#facs_1_tr_1_tl_6" n="N006"/>bedienung dises diensts zu erlassen. Sollte
					<lb facs="#facs_1_l_2" n="N007"/>es vielleicht
					<lb facs="#facs_1_tr_1_tl_7" n="N008"/>aber<note>Das Wort über der Zeile eingefügt.</note>
					<lb facs="#facs_1_l" n="N009"/>heütt oder morgen beschehen, so werde
					<lb facs="#facs_1_tr_1_tl_9" n="N010"/>ich gewisß eüren (in ansehung der mir vnd meinem
					<lb facs="#facs_1_tr_1_tl_10" n="N011"/><choice><expan>herrn</expan><abbr>he.</abbr></choice> vattern <choice><expan>seeligen</expan><abbr>see.</abbr></choice> so lang vnd getrey geleisten diensten
					<lb facs="#facs_1_tr_1_tl_11" n="N012"/>vnd absonderlich, weilen ihr mein erstr ayo gewest)
					<lb facs="#facs_1_tr_1_tl_12" n="N013"/>vor anderen in <choice><expan>khöniglicher</expan><abbr>khön.</abbr></choice> genaden zu be<corr>d</corr>enkhen. Vnd
					<lb facs="#facs_1_tr_1_tl_13" n="N014"/>ich verbleibe eüch mitt <choice><expan>khöniglichen</expan><abbr>khön.</abbr></choice> genaden allezeitt
					<lb facs="#facs_1_tr_1_tl_14" n="N015"/>wol <corr>b</corr>eythan
					<lb facs="#facs_1_tr_1_tl_17" n="N016"/>Leopoldt
					<lb facs="#facs_1_tr_1_tl_15" n="N017"/>Praag, den <del rend="strikethrough">26. <choice><expan>Decembris</expan><abbr>xb.</abbr></choice></del>
					<lb facs="#facs_1_tr_1_tl_16" n="N018"/>19. <choice><expan>Decembris</expan><abbr>xbris</abbr></choice>
				</p>
				</div><div type="page"><pb facs="#facs_2" n="2"/>
				</div><div type="page"><pb facs="#facs_3" n="3"/>
