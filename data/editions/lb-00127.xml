	<text>
		<body>
			<div>
				<div type="page"><pb facs="#facs_1" n="1"/>
				<p facs="#facs_1_tr_1">
					<lb facs="#facs_1_tr_1_tl_6" n="N001"/>Lieber <corr>gr</corr>aff von Lamberg. Auf wehrender reiß
					<lb facs="#facs_1_tr_1_tl_7" n="N002"/>hab 6 <sic rend="error" n="vnderschidliche">vnderschlidliche</sic> eurer schreiben de datis 12., 19., 26.
					<lb facs="#facs_1_tr_1_tl_8" n="N003"/><choice><expan>Decembris</expan><abbr>xbris</abbr></choice> des vorigen, 2., 9., 16. vnd 23. <choice><expan>Januarii</expan><abbr>Jan.</abbr></choice> dises Jhars
					<lb facs="#facs_1_line_1763939097631_667" n="N004"/>zu recht erhaldten vnd <del rend="strikethrough">da<unclear>her</unclear>auß</del>
					<lb facs="#facs_1_tr_1_tl_9" n="N005"/>daraus<note>Mit diesem Wort das durchgestrichene ersetzt.</note>
					<lb facs="#facs_1_line_1763939097630_666" n="N006"/>beeder <choice><expan/><abbr>Majestäten</abbr></choice> vnd infantinen
					<lb facs="#facs_1_tr_1_tl_11" n="N007"/>wie auch des jungen prinzens guetten wolstand gern verstandten,
					<lb facs="#facs_1_tr_1_tl_12" n="N008"/>auch wie <sic rend="error" n="die">di</sic> tauff vnd fiestas et masceras abgeloffen. <corr>Wa</corr>ß
					<lb facs="#facs_1_tr_1_tl_13" n="N009"/>vnß alhie betrifft, sein wir <sic rend="error" n="zwar">zwaer</sic> Gott lob gar wol auf, aber
					<lb facs="#facs_1_line_1763939121073_677" n="N010"/>wir <del rend="strikethrough">aber</del>
					<lb facs="#facs_1_tr_1_tl_14" n="N011"/>haben<note>Mit diesem Wort das durchgestrichene ersetzt.</note>
					<lb facs="#facs_1_line_1763939121072_676" n="N012"/>auf dieser wal sehr vil vngemach gelitten,
					<lb facs="#facs_1_tr_1_tl_16" n="N013"/>dann erstlich zu behmen ist ein solcher schnee gewesen,
					<lb facs="#facs_1_tr_1_tl_17" n="N014"/>daß vnmüglich ware fordtzukhommen, nacher in Frankhen
					<lb facs="#facs_1_line_1764016599676_1180" n="N015"/>ist
					<lb facs="#facs_1_tr_1_tl_18" n="N016"/>ein<note>Das Wort über der Zeile eingefügt.</note>
					<lb facs="#facs_1_line_1764016599676_1179" n="N017"/>solches gewasser angeloffen, daß wir forzatamente haben
					<lb facs="#facs_1_line_1763940369605_757" n="N018"/>vil <del rend="strikethrough">tg</del>
					<lb facs="#facs_1_line_1763940378361_763" n="N019"/>tag<note>Das Wort über der Zeile eingefügt.</note>
					<lb facs="#facs_1_line_1763940369604_756" n="N020"/>still ligen. Entlich ist ein solches khotwerkh
					<lb facs="#facs_1_tr_1_tl_21" n="N021"/>darauß worden, daß die schwere furhen in khott vber
					<lb facs="#facs_1_tr_1_tl_22" n="N022"/>nacht stekhen bliben. Ma per spinas ad rosam. De negotijs:
					<lb facs="#facs_1_tr_1_tl_23" n="N023"/><seg type="code" n="Mainz">AI</seg> <seg type="cypher" n="vermeint woll vnd sagt, er wo">v 3 r m 3 5 n 6 t w 7 ge l fa l v 6 4 n lo d s 1 ga g t 3 r 6 <w type="start">w 7 fa</w></seg>
					<lb facs="#facs_1_tr_1_tl_24" n="N024"/><seg type="cypher" n="lle die wahl nitt verschiebem"><w type="end">4 l l 3</w> 8 d 5 3 6 2 w 1 Ki h l 9 n 5 t gaK t 6 v 3 r lom s c 8 h 5 3 4 6 b 3 gad m</seg>,
					<lb facs="#facs_1_tr_1_tl_25" n="N025"/><seg type="cypher" n="aber es miesse vorhin ein versuech">1 b 3 r ro 3 s 4 m 5 3 s fu s 3 gli v 7 r h K i n 6 3 5 n fe v 3 r lim s 9 3 c 6 h</seg>
					<lb facs="#facs_1_tr_1_tl_26" n="N026"/><seg type="cypher" n="des fridens geschehen">d 3 s 6 8 f bo r 5 2 d 3 4 n s la ba do 6 g 3 8 s ta c h 3 4 6 h 3 n</seg>.
					<lb facs="#facs_1_tr_1_tl_27" n="N027"/><seg type="code" n="Peñaranda">BO</seg> <seg type="cypher" n="sagt">s 1 go g t</seg>, Er khönne nit vnd <seg type="cypher" n="wolle net von">w 7 l fi l 3 6 8 n 4 3 t v 7 n</seg>
					<lb facs="#facs_1_tr_1_tl_28" n="N028"/><seg type="cypher" n="friden heren">f 6 r 5 d 3 n go h 3 r 6 4 3 n</seg>, vil weniger <seg type="cypher" n="tractiren">fo t r 1 6 c 4 t 5 r 8 3 n</seg>.
				</p>
				</div><div type="page"><pb facs="#facs_2" n="2"/>
				<p facs="#facs_2_tr_2">
					<lb facs="#facs_2_tr_2_tl_2" n="N001"/>Diß ist die vrsach, <seg type="cypher" n="warumben">w 1 fi r 9 m glo b 3 6 n</seg> <seg type="code" n="König von Ungarn">AB</seg> <seg type="cypher" n="noch">n 7 6 4 2 so h</seg>
					<lb facs="#facs_2_tr_2_tl_3" n="N002"/><seg type="cypher" n="nitt auf">n 5 6 t 4 t am 1 9 f</seg> <seg type="code" n="Frankfurt">BM</seg> <seg type="cypher" n="khommet">K 6 h 7 m po m 3 ta t</seg>. <seg type="code" n="Legati mei Frankhfurti">BN</seg> <seg type="cypher" n="seint">s 3 5 n 6 t</seg>
					<lb facs="#facs_2_tr_2_tl_4" n="N003"/><seg type="cypher" n="ganz des">g 1 6 mo n z fo pa d 3 6 4 s</seg> <seg type="code" n="Peñaranda">BO</seg> <seg type="cypher" n="meinung">m 3 5 glo n 9 fe n g</seg>, wie
					<lb facs="#facs_2_tr_2_tl_5" n="N004"/>euch mitt mehrern <seg type="cypher" n="der">d fo 6 4 3 r</seg> <seg type="code" n="Portia">AS</seg> <seg type="cypher" n="s[ch]reiben">s ga r 3 5 4 b <unclear>8</unclear> 3 n</seg>
					<lb facs="#facs_2_tr_2_tl_6" n="N005"/><seg type="cypher" n="wirdt">w 5 pi r 6 d 2 t</seg>. Verbleibe euch in vbrigen mitt allen
					<lb facs="#facs_2_l_3" n="N006"/><choice><expan>khöniglichen</expan><abbr>khön.</abbr></choice> genaden wol gewogen
					<lb facs="#facs_2_l_2" n="N007"/>Leopoldt
					<lb facs="#facs_2_tr_2_tl_8" n="N008"/>Aschaffenburg,
					<lb facs="#facs_2_tr_2_tl_9" n="N009"/>den 13. Merzen
					<lb facs="#facs_2_tr_2_tl_11" n="N010"/>1658
					<lb facs="#facs_2_l" n="N011"/>P. S.
					<lb facs="#facs_2_tr_2_tl_12" n="N012"/>Hiebey khomen brieff an Ihr <choice><expan/><abbr>Majestäten</abbr></choice> den khonig
					<lb facs="#facs_2_tr_2_tl_13" n="N013"/>vnd khonigin, welch <del rend="strikethrough">vbr</del> geburendt vberandtwordten
					<lb facs="#facs_2_tr_2_tl_14" n="N014"/>werdet.
