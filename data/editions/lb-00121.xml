	<text>
		<body>
			<div>
				<div type="page"><pb facs="#facs_1" n="1"/>
				<p facs="#facs_1_tr_1">
					<lb facs="#facs_1_tr_1_tl_1" n="N001"/>Lieber von Lamberg. Vnder dato den 1. Augusti <w type="start">jungst</w>
					<lb facs="#facs_1_tr_1_tl_2" n="N002"/><w type="end">hin</w> hab ich eüch ein zifra, so in eigenhendigen <sic rend="error" n="schreiben">sreiben</sic>
					<lb facs="#facs_1_tr_1_tl_3" n="N003"/>zu gebrauchen, vberschikhett. Weil ich aber verstanden, daß
					<lb facs="#facs_1_tr_1_tl_4" n="N004"/>selbige ordinari von franzosen intercipierdt seyn,
					<lb facs="#facs_1_l_3" n="N005"/>also<sic rend="error" n="vberschikhe"> vbersikhe</sic> eüch hiebey ein neue
					<lb facs="#facs_1_tr_1_tl_5" n="N006"/>zifra
					<lb facs="#facs_1_l_2" n="N007"/>vnd habe ich
					<lb facs="#facs_1_tr_1_tl_7" n="N008"/>die vorige possedirdt alß daß Pater noster, also possedire
					<lb facs="#facs_1_tr_1_tl_8" n="N009"/>ich dise wie daß Ave Maria. Vnd weilen ich ein
					<lb facs="#facs_1_l_1" n="N010"/>liebhaber musices bin, <del rend="strikethrough">also wollet</del>
					<lb facs="#facs_1_tr_1_tl_9" n="N011"/>così mi
					<lb facs="#facs_1_l" n="N012"/>mandarete
					<lb facs="#facs_1_tr_1_tl_11" n="N013"/>qualche compositioni spag<corr>n</corr>ole così per chiesa come
					<lb facs="#facs_1_tr_1_tl_12" n="N014"/>per camera. Den Standt der negotien wirdt eüch der
					<lb facs="#facs_1_tr_1_tl_13" n="N015"/>Portia außfürlich vberschreiben. Vnd ich verbleibe eüch
					<lb facs="#facs_1_tr_1_tl_14" n="N016"/>mitt <choice><expan>königlichen</expan><abbr>kön.</abbr></choice> hulden vnd genaden jederzeitt wol beygethan
					<lb facs="#facs_1_tr_1_tl_17" n="N017"/>Leopoldt
					<lb facs="#facs_1_tr_1_tl_15" n="N018"/>Praag, den. 7. <choice><expan>Novembris</expan><abbr>9bris</abbr></choice>
					<lb facs="#facs_1_tr_1_tl_16" n="N019"/>1657
				</p>
				</div><div type="page"><pb facs="#facs_2" n="2"/>
				</div><div type="page"><pb facs="#facs_3" n="3"/>
				</div><div type="page"><pb facs="#facs_4" n="4"/>
			</div></div>
