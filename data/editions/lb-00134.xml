	<text>
		<body>
			<div>
				<div type="page"><pb facs="#facs_1" n="1"/>
				<p facs="#facs_1_tr_1">
					<lb facs="#facs_1_tr_1_tl_1" n="N001"/>Lieber Lamberg. Ich hab 3 <choice><expan>schreiben</expan><abbr>sch.</abbr></choice> von euch de datis 6., 13.
					<lb facs="#facs_1_tr_1_tl_2" n="N002"/>vnd 20. Merzen empfangen vnd daraus gar gern beder <choice><expan/><abbr>Majestäten</abbr></choice>
					<lb facs="#facs_1_tr_1_tl_3" n="N003"/>vnd <choice><expan/><abbr>durchlauchten</abbr></choice> guetten wolstandt <corr>ve</corr>rstanden. Waß vnß anbelangt,
					<lb facs="#facs_1_tr_1_tl_4" n="N004"/>sein wir alle gott lob wol auf, <corr>a</corr>ber die weil ist vnß schir zu lang.
					<lb facs="#facs_1_tr_1_tl_5" n="N005"/><seg type="cypher">6 fa 4 go</seg> <seg type="code" n="Mainz">AI</seg> <seg type="cypher" n="last von frieden ab, behardt aber auf">L 1 s 2 t 4 8 9 7 n f gli r 5 d 6 el 3 n 2 1 b b <corr>3</corr> h 1 r 4 d 8 t 1 b 3 r fo 1 9 f</seg>
					<lb facs="#facs_1_tr_1_tl_6" n="N006"/><seg type="cypher" n="einer harten capitulation">fa 3 5 6 n 4 3 r h 1 r gle t 3 8 n c 6 1 p 5 t 9 l 1 t 5 7 n</seg>, vnd zwar in specie
					<lb facs="#facs_1_tr_1_tl_7" n="N007"/><seg type="cypher" n="mann auf keine weis">dis glo m 1 n 2 4 n fom 1 9 f K 3 5 n 3 6 gli w 3 pa 5 s</seg> <seg type="code" n="dem König von Spanien">AC</seg> <seg type="cypher" n="contra">bi c 7 n 2 t r 6 1 4 8</seg>
					<lb facs="#facs_1_tr_1_tl_8" n="N008"/><seg type="code" n="den König von Frankreich">AE</seg> <seg type="cypher" n="hilf leisten solle">ro h 5 l 6 f pe l 3 5 s t 2 4 3 n Ki s 7 l gli l 3</seg> vnd sein <seg type="cypher" n="gle">glo <w type="start">g 2 l 3</w></seg>
					<lb facs="#facs_1_tr_1_tl_9" n="N009"/><seg type="cypher" n="icher meinung"><w type="end">5 c 4 h 3 r</w> for m <corr>3</corr> 4 5 n ca 9 n 6 g</seg> <seg type="code" n="Köln">AK</seg> <seg type="cypher" n="und">9 n 2 6 gli d</seg> <seg type="code" n="Pfalz">AP</seg>. Herendtgen
					<lb facs="#facs_1_tr_1_tl_10" n="N010"/><seg type="cypher" n="halten es mitt uns">glo fo h 1 l <corr>6</corr> t 3 n 4 3 s m i t 4 t 9 n gi s</seg> vnd haldten die <seg type="cypher" n="vorige meinung">9 7 r 5 g 3 ge m 3 5 n 9 n g</seg>
					<lb facs="#facs_1_tr_1_tl_11" n="N011"/><seg type="cypher" n="fur erroneam">ba f 9 r 4 3 r 6 r 7 bo n 3 1 m</seg> <seg type="code" n="Bayern">AM</seg> <seg type="cypher" n="et">3 t</seg> <seg type="code" n="Sachsen">AN</seg> <seg type="cypher">fa 6 4 8 2 so</seg>. <seg type="code" n="Trier">AL</seg> <seg type="cypher" n="vnd">9 n 2 d</seg> <seg type="code" n="Brandenburg">AO</seg> <seg type="cypher" n="sein">s 3 5 n</seg>
					<lb facs="#facs_1_tr_1_tl_12" n="N012"/><seg type="cypher" n="zwar guet, aber sehr timidi vnd irresoluti">z w 1 2 r g 9 3 t gli 1 b 3 4 r s 3 h r t <corr>5</corr> m 5 4 d 5 9 n 4 6 d 5 r r 2 3 s 7 l 9 t 5 2 6</seg>.
					<lb facs="#facs_1_tr_1_tl_13" n="N013"/>Morgen wirdt Khur Coln sein einzug hier haldten, des gleichen
					<lb facs="#facs_1_tr_1_tl_14" n="N014"/>Pfalz khonftigen montag oder dinstag. Gesterdt ist der erzherzog
					<lb facs="#facs_1_tr_1_tl_16" n="N015"/>privatamente bey Khur Saxen zu gast gewesen vnd hatt in <w type="start">bru</w>
					<lb facs="#facs_1_tr_1_tl_17" n="N016"/><w type="end">derlichen</w> vertrawen ein guettes Jesuiter reischel<note>Jesuitenrausch = ein mäßiger, unsündlicher Rausch.</note> heimgebracht.
					<lb facs="#facs_1_l_5" n="N017"/>Imb vbrigem, <del rend="strikethrough">waß<gap/> betrifft</del>
					<lb facs="#facs_1_tr_1_tl_19" n="N018"/>in negotio tibi noto,<note>Mit diesen Wörtern die gestrichenen ersetzt.</note>
					<lb facs="#facs_1_l_3" n="N019"/>schreibt der Portia mehr. Vnd ich
					<lb facs="#facs_1_tr_1_tl_20" n="N020"/>verbleibe jederzeitt euch mitt allen <choice><expan>koniglichen</expan><abbr>kon.</abbr></choice> genaden wol beygethan
					<lb facs="#facs_1_tr_1_tl_23" n="N021"/>Leopoldt
					<lb facs="#facs_1_tr_1_tl_24" n="N022"/><choice><expan>Frankfurdt</expan><abbr>FFurdt</abbr></choice>, den 26. April
					<lb facs="#facs_1_tr_1_tl_27" n="N023"/>1658
					<lb facs="#facs_1_l" n="N024"/>P. S.
