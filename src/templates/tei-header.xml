<TEI xmlns="http://www.tei-c.org/ns/1.0">
<teiHeader >
    <fileDesc>
        <titleStmt>
            <title type="main">{{ title }}</title>
            <title type="sub">Korrespondenz von Kaiser Leopold I</title>{% for x in sender %}
            <author key="#lb-person-{{x.id}}">{{ x.value }}</author>{% endfor %}
            <editor key="https://d-nb.info/gnd/132150654">
                <forename>Petr</forename>
                <surname>Maťa</surname>
            </editor>{% if contributors and credits %}
            <respStmt>
                <resp>{{ credits }}</resp>{% for x in contributors %}
                <persName n="{{ x.label }}" {% if x.uri %} key="{{ x.uri }}"{% endif %}>
                    <surname>{{ x.last_name }}</surname>
                    <forename>{{ x.first_name }}</forename>
                </persName>{% endfor %}
            </respStmt>{% endif %}
        </titleStmt>
        <publicationStmt>
            <publisher key="https://d-nb.info/gnd/1001454-8">Österreichische Akademie der Wissenschaften</publisher>
            <date when="2028"/>
            <availability status="free">
               <licence target="https://creativecommons.org/licenses/by/4.0/deed.de">Lizenziert unter CC-BY-4.0 (https://creativecommons.org/licenses/by/4.0/deed.de)</licence>
            </availability>
        </publicationStmt>
        <sourceDesc>
            <listWit>
                <witness>
                    <msDesc>
                        <msIdentifier>{% for x in archiv %}
                            <repository {% if x.gnd_url %}ref="{{ x.gnd_url }}"{% endif %} n="{{ x.abbr }}">{{ x.label }}</repository>{% endfor %}
                            <collection>{{ collection }}</collection>
                            <idno>{{ signatur }}</idno>
                        </msIdentifier>
                        <history>   
                            <origin>{% for x in kind %}
                                <term>{{ x.value }}</term>{% endfor %}
                                <origDate when-iso="{{ not_before }}" />
                            </origin>
                        </history>
                    </msDesc>
                </witness>
            </listWit>{% if related_letters or copy_of or concept_of %}
            <listRelation>{% for x in related_letters %}
                <relation active="{{ x.id }}.xml" {% for y in x.kind %}
                    n="{{ y.value }}" {% endfor %}
                    passive="{{ lb_id }}.xml"/>{% endfor %}{% for x in copy_of %}                
                <relation active="{{ lb_id }}.xml" {% for y in kind %} n="{{ y.value }}" {% endfor %} passive="{{ x.value }}.xml"/>{% endfor %}
            </listRelation>{% endif %}
        </sourceDesc>
    </fileDesc>
    <profileDesc>
        <langUsage>
            <language ident="{{ main_language.value }}"/>
        </langUsage>
        <correspDesc>
            <correspAction type="sent">{% for x in sender %}
                <persName ref="#lb-person-{{x.id}}">{{ x.value }}</persName>{% endfor %}
                <date notBefore-iso="{{ not_before }}" notAfter-iso="{{ not_after }}">{{ written_date }}</date>{% for x in place_of_writing %}
                <placeName ref="#{{ x.id }}">{{ x.label }}</placeName>{% endfor %}
            </correspAction>
            <correspAction type="received">{% for x in receiver %}
                <persName ref="#{{ x.lb_id }}">{{ x.label }}</persName>{% endfor %}{% for x in received_place %}
                <placeName ref="#{{ x.lb_id }}">{{ x.label }}</placeName>{% endfor %}{% if received_date %}
                <date when="{{ received_date }}"/>{% endif %}
            </correspAction>
        </correspDesc>
    </profileDesc>
    <revisionDesc>
        <change xml:id="metadaten-status">{{ status_metadaten.value }}</change>
        <change xml:id="transkription-status">{{ status_transkription.value }}</change>
    </revisionDesc>
</teiHeader>
</TEI>